pipeline {
    agent any

    stages {
        stage('Gracze online') {
            steps {
                powershell '''
                    $ErrorActionPreference = 'Stop'
                    $appid = 570
                    $url = "https://api.steampowered.com/ISteamUserStats/GetNumberOfCurrentPlayers/v1/?appid=$appid"
                    $result = Invoke-RestMethod -Uri $url -UseBasicParsing -TimeoutSec 20
                    Write-Host "AppID: $appid | Gracze online: $($result.response.player_count)"
                '''
            }
        }
    }
}
